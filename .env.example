# Placeholder values only — never commit real secrets. Copy to .env.
# Same settings as the platform's .env.example; its comments explain each.
# Format: one KEY=value per line, no spaces around =, single quotes around a
# value containing $, # or a space.

# The app's login (savic_app), from the password manager. Never the
# migrator login: that goes in .env.migrator, for init only.
DATABASE_URL=postgresql+psycopg2://<user>:<url-encoded-password>@<server>.postgres.database.azure.com:5432/savic_platform?sslmode=require
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# Which project modules the platform loads. The Docker image already sets
# this; set it here only to override.
# SAVIC_EXTENSIONS=["mis_ai.extension"]

ENVIRONMENT=development
# false: no cron job fires in your backend. Keep it false while several
# developers' backends share one database; run a job by hand instead
# (Administration → Scheduled Jobs).
SCHEDULER_ENABLED=false

REFRESH_COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]

SMTP_HOST=
ENABLE_REFERENCE_WRAPPERS=false
ENABLE_TEST_TENANT_SEED=false
