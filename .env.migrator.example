# Migration owner only: `docker compose run --rm init`. Copy to
# .env.migrator; never commit it. For this local-only setup the database role
# is the same local role used by the backend. Shared environments must use a
# separately managed migration-owner login.

# The local migration connection. The init service rewrites the host to `db`.
DATABASE_URL=postgresql+psycopg2://savic_app:change-me-local-only@localhost:5432/savic_platform

# init ends with the platform's bootstrap seed, which grants the
# administrator role every menu, this project's new ones included. It looks
# the company and administrator up by these two values: against an existing
# database, set them to the values it already has, or it creates new ones.
BOOTSTRAP_COMPANY_CODE=LOCAL
BOOTSTRAP_COMPANY_NAME=Local Development
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@localhost.test
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-local-only
PLATFORM_ADMIN_USERNAME=platform_admin
PLATFORM_ADMIN_EMAIL=platform-admin@localhost.test
PLATFORM_ADMIN_PASSWORD=change-me-platform-admin-local-only
