# Migration owner only: `docker compose run --rm init`. Copy to
# .env.migrator; never commit it. Every key here overrides .env for init.

# The schema-owning login (savic_migrator), not the app's login.
DATABASE_URL=postgresql+psycopg2://<migrator-user>:<url-encoded-password>@<server>.postgres.database.azure.com:5432/savic_platform?sslmode=require

# init ends with the platform's bootstrap seed, which grants the
# administrator role every menu, this project's new ones included. It looks
# the company and administrator up by these two values: against an existing
# database, set them to the values it already has, or it creates new ones.
BOOTSTRAP_COMPANY_CODE=<EXISTING_COMPANY_CODE>
BOOTSTRAP_COMPANY_NAME=<Existing Company Name>
BOOTSTRAP_ADMIN_USERNAME=<existing-admin-username>
BOOTSTRAP_ADMIN_EMAIL=<existing-admin@company.com>
BOOTSTRAP_ADMIN_PASSWORD=<only-used-if-creating>
PLATFORM_ADMIN_USERNAME=platform_admin
PLATFORM_ADMIN_EMAIL=<platform.admin@company.com>
PLATFORM_ADMIN_PASSWORD=<only-used-if-creating>
